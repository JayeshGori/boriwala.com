# ─────────────────────────────────────────────────────────────
# Email (SMTP) — REQUIRED for welcome / approval / bulk emails
# Without these, emails are only logged to the server console.
#
# Gmail:      host=smtp.gmail.com     port=465  (use a 16-char App Password)
# Zoho:       host=smtp.zoho.in       port=465
# Hostinger:  host=smtp.hostinger.com port=465
# Outlook:    host=smtp.office365.com port=587
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@boriwala.com
SMTP_PASS=your-smtp-password-or-app-password
EMAIL_FROM=Boriwala Trading <info@boriwala.com>

# Where new-registration alerts are sent. Falls back to ADMIN_EMAIL if unset.
# Comma-separate for multiple recipients: ops@boriwala.com,sales@boriwala.com
ADMIN_NOTIFICATION_EMAIL=admin@boriwala.com
